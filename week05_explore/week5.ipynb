    "class RandomNetworkDistilationModule(BaseIntrinsicRewardModule):\n",
    "    def __init__(self, states_size, features_size, hidden_size, alpha=0.1):\n",
    "        super().__init__()\n",
    "        self.random_module = MLP(\n",
    "            states_size,\n",
    "            hidden_size,\n",
    "            features_size\n",
    "        )\n",
    "        for param in self.random_module.parameters(): param.requires_grad = False \n",
    "\n",
    "        self.prediction_model = MLP(\n",
    "            states_size,\n",
    "            hidden_size,\n",
    "            features_size\n",
    "        )\n",
    "        self.mean_reward = 0 \n",
    "        self.alpha = alpha\n",
    "\n",
    "    def forward(self, state):\n",
    "        return self.prediction_model(state)\n",
    "    \n",
    "    def get_intrinsic_reward(self, state, action, next_state):\n",
    "        with torch.no_grad():\n",
    "            r = torch.norm(self.prediction_model(state)  - self.random_module(state), p=2, dim=-1)\n",
    "            r_centered = r - self.mean_reward\n",
    "            self.mean_reward = self.alpha * (r) + (1 - self.alpha) * self.mean_reward\n",
    "            return r_centered.item()\n",
    "\n",
    "    def get_loss(self, state_batch, action_batch, next_state_batch):\n",
    "        loss = torch.mean((self.prediction_model(state_batch)  - self.random_module(state_batch)) ** 2)\n",
    "        return loss"
   ]
