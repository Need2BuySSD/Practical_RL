    "class Embedder(nn.Module):\n",
    "    def __init__(self, states_size, hidden_size, embedding_size):\n",
    "        super().__init__()\n",
    "        self.module = MLP(\n",
    "            states_size,\n",
    "            hidden_size,\n",
    "            embedding_size\n",
    "        )\n",
    "        \n",
    "    def forward(self, s):\n",
    "        return self.module(s)\n",
    "        \n",
    "class ICMModule(BaseIntrinsicRewardModule):\n",
    "    def __init__(self, states_size, n_actions, hidden_size, embedding_size, alpha=0.1):\n",
    "        super().__init__()\n",
    "        self.embedder = Embedder(states_size, hidden_size, embedding_size)\n",
    "        self.forward_model = MLP(embedding_size + n_actions, hidden_size, embedding_size)\n",
    "        self.inverse_model = MLP(2 * embedding_size, hidden_size, n_actions) \n",
    "        self.mean_reward = 0 \n",
    "        self.n_actions = n_actions\n",
    "        self.alpha = alpha\n",
    "\n",
    "    def forward_inf(self, s, a):\n",
    "        return s + self.forward_model(torch.concat([s, a], dim=-1))\n",
    "\n",
    "    def inverse_inf(self, s, s_next):\n",
    "        return torch.softmax(self.inverse_model(torch.concat([s, s_next], dim=-1)), dim=-1)\n",
    "\n",
    "    def get_intrinsic_reward(self, state, action, next_state):\n",
    "        with torch.no_grad():            \n",
    "            enc_a = to_one_hot(action, self.n_actions)\n",
    "            emb_s = self.embedder(state)\n",
    "            emb_next_s =self.embedder(next_state)\n",
    "\n",
    "            r = torch.norm(self.forward_inf(emb_s, enc_a)  - emb_next_s, p=2, dim=-1)\n",
    "                #-torch.sum(torch.log(self.inverse_inf(emb_s, emb_next_s)) * enc_a, dim=-1)\n",
    "            r_centered = r - self.mean_reward\n",
    "            self.mean_reward = self.alpha * (r) + (1 - self.alpha) * self.mean_reward\n",
    "            return r_centered.item()\n",
    "\n",
    "\n",
    "    def get_loss(self, state_batch, action_batch, next_state_batch):\n",
    "        # embeddings\n",
    "        state_emb_batch = self.embedder(state_batch)\n",
    "        next_state_emb_batch = self.embedder(next_state_batch)\n",
    "        a_one_hot = to_one_hot(action_batch, self.n_actions)\n",
    "\n",
    "        # forward part\n",
    "        predicted_next_state_batch = self.forward_inf(state_emb_batch, a_one_hot)\n",
    "        forward_loss = torch.mean((predicted_next_state_batch - next_state_emb_batch) ** 2)\n",
    "        \n",
    "        # inverse part\n",
    "        a_pred_proba = self.inverse_inf(state_emb_batch, next_state_emb_batch)\n",
    "        inverse_loss = -(torch.log(a_pred_proba) * a_one_hot).sum(dim=-1).mean()\n",
    "        \n",
    "        return forward_loss + inverse_loss"
