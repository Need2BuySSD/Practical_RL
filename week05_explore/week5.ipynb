    "from collections import deque\n",
    "\n",
    "\n",
    "class DBAgent(AbstractAgent):\n",
    "    def __init__(self, buffer_size=1000):\n",
    "        self.buffer = deque(maxlen=buffer_size)\n",
    "\n",
    "    def update(self, action, reward):\n",
    "        \"\"\"\n",
    "        Observe reward from action and update agent's internal parameters\n",
    "        :type action: int\n",
    "        :type reward: int\n",
    "        \"\"\"\n",
    "        super().update(action,reward)\n",
    "        self.buffer.append((action, reward))\n",
    "\n",
    "    def get_buffer_data(self):\n",
    "        recent_succeses = np.zeros(self._successes.shape)\n",
    "        recent_failures = np.zeros(self._failures.shape)\n",
    "        for action, reward in self.buffer:\n",
    "            if reward != 0:\n",
    "                recent_succeses[action] += 1\n",
    "            else:\n",
    "                recent_failures[action] += 1\n",
    "        recent_pulls = len(self.buffer)\n",
    "        return recent_pulls, recent_succeses,  recent_failures\n",
    "\n",
    "    def get_action(self): \n",
    "        recent_pulls, recent_succeses,  recent_failures = self.get_buffer_data()\n",
    "        return np.argmax(np.random.beta(recent_succeses + 1, recent_failures + 1))"
   ]
