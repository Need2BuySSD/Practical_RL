    "class GoRightReward(BaseIntrinsicRewardModule):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "    def get_intrinsic_reward(self, state, action, next_state):\n",
    "        state_x = torch.argmax(state)%np.sqrt(state.shape[1])\n",
    "        state_y = torch.argmax(state)//np.sqrt(state.shape[1])\n",
    "        next_state_x = torch.argmax(next_state)%np.sqrt(next_state.shape[1])\n",
    "\n",
    "        return 0.1 if next_state_x > state_x and state_x == state_y else 0"
