    "class UCBAgent(AbstractAgent):\n",
    "    def get_action(self):\n",
    "        pulls = self._successes + self._failures + 0.1\n",
    "        index = np.sqrt(2 * np.log(self._total_pulls + 0.1) / pulls) if self._total_pulls > 0 else 0\n",
    "        return np.argmax(self._successes / pulls + index)"
   ]
